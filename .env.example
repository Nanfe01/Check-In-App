# Generate a unique random value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CODE_SECRET=

# Generate a different unique random value for staff with the same command.
STAFF_KEY=

# Cloudflare Access team domain and the Audience (AUD) tag of the staff app.
# Protect /scan and the staff API paths with an Allow policy for event staff.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# SQLite database file path
DB_PATH=delegates.db

# Public base URL used by seed.py when generating personalized invite links
BASE_URL=http://localhost:8000
